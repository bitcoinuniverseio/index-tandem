---
import Default from "@astrojs/starlight/components/Head.astro";
import { ogSlugFromPathname } from "../lib/og";

const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL("https://bitcoinuniverse.github.io/index-tandem/");
const slug = ogSlugFromPathname(Astro.url.pathname, base);
const ogImage = new URL(`${base.replace(/\/+$/, "")}/og/${slug}.png`, site).href;

const { entry } = Astro.locals.starlightRoute;
const title = entry.data.title;
const description = entry.data.description ?? undefined;

const structured = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  ...(description ? { description } : {}),
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    name: "Tandem",
    url: new URL(base, site).href,
  },
  about: {
    "@type": "SoftwareSourceCode",
    name: "Tandem indexer pipeline A",
    codeRepository: "https://github.com/bitcoinuniverse/index-tandem",
    programmingLanguage: "TypeScript",
    license: "https://opensource.org/licenses/MIT",
  },
};
---

<Default><slot /></Default>

<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`Tandem documentation: ${title}`} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#0a0b0d" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />
<meta name="format-detection" content="telephone=no" />
<script type="application/ld+json" set:html={JSON.stringify(structured)} is:inline />
