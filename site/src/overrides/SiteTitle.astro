---
import PairMark from "../components/PairMark.astro";

const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
---

<a href={home} class="tdm-sitetitle">
  <PairMark size={22} />
  <span class="tdm-sitetitle__word">Tandem</span>
  <span class="tdm-sitetitle__sub">indexer and protocol documentation</span>
</a>

<style>
  .tdm-sitetitle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--tdm-text);
    min-width: 0;
  }

  .tdm-sitetitle__word {
    font-family: var(--tdm-font-display);
    font-size: 1.375rem;
    line-height: 1;
    letter-spacing: -0.01em;
    padding-top: 0.1em;
  }

  .tdm-sitetitle__sub {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tdm-text-faint);
    padding-inline-start: 0.6rem;
    border-inline-start: 1px solid var(--tdm-line);
    white-space: nowrap;
  }

  @media (max-width: 62rem) {
    .tdm-sitetitle__sub {
      display: none;
    }
  }
</style>
