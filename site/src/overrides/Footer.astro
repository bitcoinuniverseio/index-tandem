---
import Default from "@astrojs/starlight/components/Footer.astro";
import PairMark from "../components/PairMark.astro";

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const link = (path: string) => `${base}${path}`;
---

<Default><slot /></Default>

<footer class="tdm-foot not-content">
  <div class="tdm-foot__mark">
    <PairMark size={20} />
    <span>Tandem</span>
  </div>
  <nav class="tdm-foot__nav" aria-label="Documentation sections">
    <a href={link("/discover/what-is-tandem/")}>Discover</a>
    <a href={link("/experience/")}>Experience</a>
    <a href={link("/build/quickstart/")}>Build</a>
    <a href={link("/operate/architecture/")}>Operate</a>
    <a href={link("/understand/protocol/")}>Understand</a>
    <a href={link("/tools/agreement-inspector/")}>Tools</a>
    <a href={link("/participate/roadmap/")}>Participate</a>
  </nav>
  <p class="tdm-foot__legal">
    <a href="https://github.com/bitcoinuniverse/index-tandem">Indexer repository</a>
    <span aria-hidden="true">/</span>
    <a href="https://github.com/bitcoinuniverse/tandem">Protocol contract</a>
    <span aria-hidden="true">/</span>
    <a href={link("/participate/security-reporting/")}>Report a security issue</a>
    <span aria-hidden="true">/</span>
    <span>MIT licensed</span>
  </p>
  <p class="tdm-foot__warn">
    Tandem is not activated on Bitcoin mainnet. Verified mainnet responses stay switched off unless
    an operator sets them otherwise.
  </p>
</footer>

<style>
  .tdm-foot {
    margin-top: var(--tdm-space-8);
    padding-top: var(--tdm-space-5);
    border-top: 1px solid var(--tdm-line);
    display: flex;
    flex-direction: column;
    gap: var(--tdm-space-3);
  }

  .tdm-foot__mark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--tdm-font-display);
    font-size: 1.125rem;
    color: var(--tdm-text);
  }

  .tdm-foot__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--tdm-space-4);
  }

  .tdm-foot__nav a {
    font-size: var(--tdm-step--1);
    color: var(--tdm-text-muted);
    text-decoration: none;
    padding-block: 0.35rem;
  }

  .tdm-foot__nav a:hover {
    color: var(--tdm-text);
  }

  .tdm-foot__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.6rem;
    margin: 0;
    font-size: var(--tdm-step--2);
    color: var(--tdm-text-faint);
  }

  .tdm-foot__legal a {
    color: var(--tdm-text-faint);
    text-decoration: none;
    border-bottom: 1px solid var(--tdm-line);
    padding-block: 0.2rem;
  }

  .tdm-foot__legal a:hover {
    color: var(--tdm-text);
  }

  .tdm-foot__warn {
    margin: 0;
    font-size: var(--tdm-step--2);
    line-height: 1.55;
    color: var(--tdm-text-faint);
    max-width: 62ch;
  }
</style>
