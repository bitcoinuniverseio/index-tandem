NODE_ENV=development
HTTP_HOST=127.0.0.1
PORT=3021
TANDEM_NETWORK=regtest
# Leave TANDEM_INIT_TXID empty to run in waiting mode before the INIT is broadcast. The INIT
# height, H_open, and H_close are read from the chain; the three optional height values and
# TANDEM_NAMESPACE are only cross-checked when set.
TANDEM_INIT_TXID=
TANDEM_INIT_HEIGHT=
TANDEM_OPEN_HEIGHT=
TANDEM_CLOSE_HEIGHT=
TANDEM_SPEC_HASH=caa77ce0122c0b833fc5f099191b54280b0481be325bdc98f2b48b0b905b923f
TANDEM_NAMESPACE=
TANDEM_SYNC_ENABLED=true
TANDEM_SYNC_POLL_MS=5000
TANDEM_INIT_SCAN_DEPTH=144
# Blocks per commit and concurrent getblock calls. Mainnet verbosity 3 blocks are ~15 MB of JSON.
TANDEM_SYNC_BATCH_BLOCKS=100
TANDEM_SYNC_FETCH_CONCURRENCY=4
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=replace-me
BITCOIN_RPC_PASSWORD=replace-me
BITCOIN_RPC_TIMEOUT_MS=15000
BITCOIN_ZMQ_HASHBLOCK=
BITCOIN_ZMQ_RAWTX=
BITCOIN_ZMQ_SEQUENCE=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tandem
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me-too
MYSQL_DATABASE=tandem_index_a
READINESS_MAX_BLOCK_LAG=2
AGREEMENT_KEY_ID=
AGREEMENT_PRIVATE_KEY_HEX=
AGREEMENT_PUBLIC_KEY_HEX=
TANDEM_PARSER_COMMIT=
TANDEM_INDEXER_COMMIT=
TANDEM_PARSER_BINARY_SHA256=
TANDEM_INDEXER_BINARY_SHA256=
PIPELINE_B_BASE_URL=
PIPELINE_B_REQUEST_TIMEOUT_MS=5000
PIPELINE_A_TRUSTED_KEYS_JSON={}
PIPELINE_B_TRUSTED_KEYS_JSON={}
TANDEM_VERIFIED_MAINNET_ENABLED=false
