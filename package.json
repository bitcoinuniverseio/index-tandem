{
  "name": "@bitcoinuniverse/index-tandem",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic Bitcoin Core indexer and API for Tandem pipeline A",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migration:run": "tsx src/database/migrate.ts",
    "migration:run:prod": "node dist/database/migrate.js",
    "openapi:emit": "tsx scripts/emit-openapi.ts",
    "docs:install": "npm --prefix site install",
    "docs:dev": "npm --prefix site run dev",
    "docs:build": "npm run openapi:emit && npm --prefix site run build && npm --prefix site run og",
    "docs:verify": "npm run openapi:emit && npm --prefix site run verify",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@bitcoinuniverse/tandem": "file:vendor/bitcoinuniverse-tandem-0.1.0.tgz",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/typeorm": "11.0.0",
    "@noble/curves": "1.9.7",
    "helmet": "8.1.0",
    "json-canonicalize": "1.2.0",
    "mysql2": "3.15.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zeromq": "6.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@nestjs/testing": "11.1.28",
    "@types/node": "22.19.1",
    "@vitest/coverage-v8": "3.2.7",
    "supertest": "7.1.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
